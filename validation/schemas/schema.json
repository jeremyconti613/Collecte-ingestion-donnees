{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spotify artist album track occurrence",
  "type": "object",
  "required": [
    "event_type",
    "seed_artist_id",
    "seed_artist_name",
    "album_id",
    "album_name",
    "album_type",
    "album_group",
    "release_date",
    "release_date_precision",
    "track_id",
    "track",
    "extracted_at_utc"
  ],
  "properties": {
    "event_type": {"const": "spotify.artist.album_track"},
    "seed_artist_id": {"type": "string", "minLength": 1},
    "seed_artist_name": {"type": ["string", "null"]},
    "album_id": {"type": "string", "minLength": 1},
    "album_name": {"type": ["string", "null"]},
    "album_type": {"type": ["string", "null"]},
    "album_group": {"type": ["string", "null"]},
    "release_date": {"type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
    "release_date_precision": {
      "type": ["string", "null"],
      "enum": ["day", "month", "year", null]
    },
    "track_id": {"type": "string", "minLength": 1},
    "track": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "artists": {"type": "array"},
        "duration_ms": {"type": ["integer", "null"], "minimum": 0},
        "explicit": {"type": ["boolean", "null"]},
        "disc_number": {"type": ["integer", "null"], "minimum": 1},
        "track_number": {"type": ["integer", "null"], "minimum": 1},
        "external_urls": {"type": "object"}
      }
    },
    "extracted_at_utc": {"type": "string", "format": "date-time"}
  }
}
