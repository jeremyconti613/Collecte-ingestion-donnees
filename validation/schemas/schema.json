{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spotify artist genre search result",
  "type": "object",
  "required": [
    "event_type",
    "genre",
    "rank",
    "ranking_method",
    "matched_genre_queries",
    "collected_at_utc",
    "artist"
  ],
  "properties": {
    "event_type": {"const": "spotify.artist.genre_search_result"},
    "genre": {"type": "string", "minLength": 1},
    "rank": {"type": "integer", "minimum": 1, "maximum": 50},
    "ranking_method": {
      "const": "spotify_search_result_order"
    },
    "matched_genre_queries": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "collected_at_utc": {"type": "string", "format": "date-time"},
    "artist": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "popularity": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "genres": {"type": "array", "items": {"type": "string"}},
        "followers": {
          "type": ["object", "null"],
          "properties": {
            "total": {"type": ["integer", "null"], "minimum": 0}
          }
        },
        "external_urls": {"type": "object"},
        "images": {"type": "array"}
      }
    }
  }
}
